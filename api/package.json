{
  "name": "eventbox-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "superadmin": "node dist/scripts/superadmin.js",
    "superadmin:dev": "ts-node --transpile-only src/scripts/superadmin.ts",
    "db:migrate": "node -e \"require('./dist/db/migrate').migrate().then(()=>process.exit(0),e=>{console.error(e);process.exit(1)})\""
  },
  "author": "SRV (wearesrv.com)",
  "license": "UNLICENSED",
  "description": "API de Event Box (SRV): stock y órdenes de servicio para empresas de eventos",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-forge": "^1.3.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/node-forge": "^1.3.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6"
  },
  "overrides": {
    "@types/express": "$@types/express",
    "@types/express-serve-static-core": "^4.19.6"
  }
}
