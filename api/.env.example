# Copiá este archivo a .env y completá los valores.
NODE_ENV=development
PORT=3000

# Obligatorio en producción. Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=20h

# Orígenes del front en producción, separados por coma (en desarrollo se acepta cualquier localhost).
CORS_ORIGINS=https://este.wearesrv.com

# URL pública de la API (Mercado Pago avisa los pagos acá) y del front (vuelta del checkout).
API_PUBLIC_URL=http://localhost:3000
APP_URL=http://localhost:5173

# Rol que administra cada empresa.
ADMIN_ROLE_ID=1

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=este
DB_SSL=false

# ---------- Suscripción ----------
MONTHLY_PRICE_USD=400
TRIAL_DAYS=14
# Días después del vencimiento en que la empresa sigue entrando (con aviso) antes del bloqueo.
BILLING_GRACE_DAYS=10
DOLLAR_API_URL=https://dolarapi.com/v1/dolares/blue

# ---------- Mercado Pago (ver docs/COBROS.md) ----------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- ARCA, factura electrónica (ver docs/COBROS.md) ----------
ARCA_CUIT=
# Certificado y clave privada: ruta a los archivos .crt/.key o el PEM pegado (con \n).
ARCA_CERT=
ARCA_KEY=
ARCA_POINT_OF_SALE=
# 11 = Factura C (monotributo)
ARCA_VOUCHER_TYPE=11
# false = homologación (pruebas, sin validez fiscal); true = producción
ARCA_PRODUCTION=false
# Datos que se imprimen en la factura
ARCA_ISSUER_NAME=
ARCA_ISSUER_ADDRESS=
ARCA_ISSUER_TAX_CONDITION=Responsable Monotributo
ARCA_ISSUER_IIBB=
ARCA_ISSUER_ACTIVITY_START=
