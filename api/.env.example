# Copiá este archivo a .env y completá los valores.
NODE_ENV=development
PORT=3000

# Obligatorio en producción. Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=20h

# Orígenes del front en producción, separados por coma (en desarrollo se acepta cualquier localhost).
CORS_ORIGINS=https://este.wearesrv.com

# URL pública de la API (Mercado Pago avisa los pagos acá) y del front (vuelta del checkout).
API_PUBLIC_URL=http://localhost:3000
APP_URL=http://localhost:5173

# Rol que administra cada empresa.
ADMIN_ROLE_ID=1

# Opción A: la URL completa que da el hosting (Railway: DATABASE_URL). Si está, pisa a las DB_* de abajo.
DATABASE_URL=
# Opción B: datos sueltos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=este
DB_SSL=false

# ---------- Suscripción ----------
TRIAL_DAYS=14
# Días después del vencimiento en que la empresa sigue entrando (con aviso) antes del bloqueo.
BILLING_GRACE_DAYS=10
DOLLAR_API_URL=https://dolarapi.com/v1/dolares/blue

# ---------- Mercado Pago (ver docs/COBROS.md) ----------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- ARCA, factura electrónica (ver docs/COBROS.md) ----------
ARCA_CUIT=
# Certificado y clave privada: ruta a los archivos .crt/.key o el PEM pegado (con \n).
ARCA_CERT=
ARCA_KEY=
ARCA_POINT_OF_SALE=
# 11 = Factura C (monotributo)
ARCA_VOUCHER_TYPE=11
# false = homologación (pruebas, sin validez fiscal); true = producción
ARCA_PRODUCTION=false
# Datos que se imprimen en la factura
ARCA_ISSUER_NAME=
ARCA_ISSUER_ADDRESS=
ARCA_ISSUER_TAX_CONDITION=Responsable Monotributo
ARCA_ISSUER_IIBB=
ARCA_ISSUER_ACTIVITY_START=

# ---------- Cloudflare R2: archivos (ver docs/ARCHIVOS_Y_MAILS.md) ----------
# Sin estas variables todo se guarda en disco (api/uploads y api/private-uploads): solo para desarrollo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Público: logos, fotos de perfil y capturas de reportes.
R2_PUBLIC_BUCKET=eventbox-public
# Privado (sin acceso público): recibos de sueldo y planos.
R2_PRIVATE_BUCKET=eventbox-private
# Dominio del bucket público, sin barra final (ej: https://archivos.wearesrv.com o https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# ---------- Resend: mails (ver docs/ARCHIVOS_Y_MAILS.md) ----------
# Sin API key, los mails se muestran en la consola y no se envían.
RESEND_API_KEY=
# Remitente: tiene que ser de un dominio verificado en Resend.
EMAIL_FROM=Event Box <no-reply@wearesrv.com>
# Adónde llegan los reportes de problemas.
SUPPORT_EMAIL=info@wearesrv.com
